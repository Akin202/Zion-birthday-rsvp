# ---------------------------------------------------------------------------
# CLIENT-SIDE (Vite). Anything prefixed VITE_ is bundled into the public JS.
# Treat every value here as PUBLIC. Never put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# Supabase project URL and anon (publishable) key.
# The anon key is designed to be public — guest data is protected by RLS:
# anon may INSERT, and may SELECT only a single row matched by edit_token.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Absolute public origin, used to build edit links and OG image URLs.
VITE_SITE_URL="https://your-domain.online"

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — Supabase Edge Function secrets.
# Set these with `npx supabase secrets set KEY=value`, NOT in this file's
# committed form and NEVER with a VITE_ prefix.
# ---------------------------------------------------------------------------

# Full-access key. Bypasses RLS. Must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Resend API key for confirmation emails.
RESEND_API_KEY="re_YOUR_RESEND_KEY"

# Verified sender address on your Resend domain.
RESEND_FROM_EMAIL="Zion's Birthday <rsvp@your-domain.online>"

# Admin account. Receives a notification on each new RSVP, and is the
# seeded Supabase Auth login for the /admin area.
ADMIN_EMAIL="admin@your-domain.online"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
